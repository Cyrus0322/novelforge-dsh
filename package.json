{
  "name": "novelforge-dsh",
  "version": "0.4.0",
  "description": "A persistent, human-approved long-form novel writing plugin for DeepSeek Harness",
  "author": "Cyrus0322",
  "license": "MIT",
  "homepage": "https://github.com/Cyrus0322/novelforge-dsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyrus0322/novelforge-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/Cyrus0322/novelforge-dsh/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "novel",
    "writing",
    "llm",
    "ai-writing"
  ],
  "type": "module",
  "main": "dist/dsh-plugin/index.js",
  "types": "dist/dsh-plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dsh-plugin/index.d.ts",
      "default": "./dist/dsh-plugin/index.js"
    },
    "./domain": {
      "types": "./dist/workflow/novel-service.d.ts",
      "default": "./dist/workflow/novel-service.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "bin": {
    "novelforge": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "lib",
    "apps/studio/dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "docs/dsh-compatibility.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:all": "pnpm run build && pnpm run build:client && pnpm run studio:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit && pnpm run studio:typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "novel": "tsx src/cli/index.ts",
    "studio": "node dist/cli/index.js studio",
    "studio:build": "pnpm --filter @novelforge/studio build",
    "studio:dev": "pnpm --filter @novelforge/studio dev",
    "studio:typecheck": "pnpm --filter @novelforge/studio typecheck",
    "prepack": "pnpm run build:all",
    "prepare": "pnpm run build && pnpm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "typecheck:client": "tsc -p src/client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "commander": "^14.0.2",
    "diff": "^8.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  }
}
