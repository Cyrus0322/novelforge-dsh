# 在 DSH 内运行：以下模型相关项都可以不填，插件会直接用宿主已配置的模型（ctx.llm）。
# 只有在「宿主没有可用提供方」或「独立 CLI」场景下才需要 API Key。
DEEPSEEK_API_KEY=
# 提供方路由，留空=自动选择（宿主默认模型 > 第一个已注册提供方）
DEEPSEEK_PROVIDER=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 留空=跟随 DSH 宿主默认模型；填值则覆盖。直连模式回退 deepseek-chat
DEEPSEEK_MODEL=
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRIES=3
NOVELFORGE_DB_PATH=./data/novelforge.db
NOVELFORGE_MAX_INPUT_TOKENS=24000
NOVELFORGE_MAX_CONTEXT_TOKENS=64000
NOVELFORGE_RECENT_CHAPTERS=3
NOVELFORGE_MAX_REVISION_ROUNDS=3
# —— 可视化工作台 Studio（pnpm run studio / novelforge studio）——
# 监听地址；绑定非本机地址时必须设置令牌
NOVELFORGE_STUDIO_HOST=127.0.0.1
# 访问令牌；设置后所有 /api/* 请求需带 x-novelforge-token 头（或 ?token=）
NOVELFORGE_STUDIO_TOKEN=
# 前端构建产物目录，默认 <包根>/apps/studio/dist
NOVELFORGE_STUDIO_DIR=
